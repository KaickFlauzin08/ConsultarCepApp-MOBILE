<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConsultarCepApp.ViewModels"
             x:DataType="vm:BuscarCepViewModel"
             x:Class="ConsultarCepApp.Views.BuscarCepPage"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False"
             Title="BuscarCepPage">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,0,0,25">
                <Label Text="📍 LocalizaCEP"
                       FontSize="32"
                       TextColor="#FFF"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Encontre qualquer endereço do Brasil"
                       FontSize="16"
                       TextColor="#FFF"/>
            </VerticalStackLayout>
            
            <!--CARD-->
            
            <Border Padding="20" BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Digite o CEP"
                           TextColor="#94A3B8"
                           FontSize="12"/>
                    <Border BackgroundColor="#0F172A"
                            HeightRequest="60"
                            Stroke="#475569"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                        <Entry TextColor="#FFF"
                               HeightRequest="75"
                               FontSize="20"
                               Keyboard="Numeric"
                               MaxLength="8"
                               Text="{Binding CepInput}"
                               HorizontalTextAlignment="Center" Placeholder="Ex:12345678"/>

                    </Border>
                    <Button Text="Buscar Endereço"
                        CornerRadius="16"
                        BackgroundColor="#6366F1"
                        FontSize="18"
                        Command="{Binding BuscarCepCommand}"/>
                </VerticalStackLayout>
            </Border>
            
            <!--CARD ONDE APARECE AS INFOS-->
            
            <Border Padding="25" BackgroundColor="#1E293B" 
                    Stroke="#10B981"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="2"
                    Margin="0,20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📌 Endereço encontrado" FontSize="18"
                           TextColor="#FFF"
                           HorizontalOptions="Center"/>
                    <BoxView HeightRequest="1" Color="#334155" Margin="0,10"/>
                    
                    <Grid ColumnDefinitions="Auto,*" 
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="15"
                          RowSpacing="20">
                        
                        <!--ENDEREÇO-->
                        
                        <Label Grid.Column="0" Grid.Row="0"
                               FontSize="24"
                               Text="🛣️"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Row="0"
                                             Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="Endereço"
                                   FontSize="12"
                                   TextColor="#94A368"/>
                            <Label Text="{Binding Resultado.Address}"
                                   FontSize="18" 
                                   TextColor="#FFF"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!--BAIRRO-->

                        <Label Grid.Column="0" Grid.Row="1"
                               FontSize="24"
                               Text="🏘️"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="Bairro"
                                   FontSize="12"
                                   TextColor="#94A368"/>
                            <Label Text="{Binding Resultado.District}"
                                   FontSize="17" 
                                   TextColor="#FFF"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        
                        <!--CIDADE / ESTADO-->
                        
                        <Label Grid.Column="0" Grid.Row="2"
                               FontSize="24"
                               Text="🗺️"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Row="2"
                                             Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="Cidade / Estado"
                                   FontSize="12"
                                   TextColor="#94A368"/>
                            <Label
                                   FontSize="18" 
                                   TextColor="#FFF"
                                   FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Resultado.City}" TextColor="#FFF"/>
                                        <Span Text=" / " TextColor="#FFF"/>
                                        <Span Text="{Binding Resultado.State}" TextColor="#FFF"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <Button Command="{Binding NavegarCnpjCommand}" Text="BUSCAR CNPJ"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>